{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes",
  "version": "0.19.2",
  "identifier": "com.nousresearch.hermes",
  "build": {
    "beforeBuildCommand": "node scripts/assert-root-install.mjs && vite build",
    "beforeDevCommand": "node scripts/assert-root-install.mjs && vite --host 127.0.0.1 --port 5174",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "resources": {
      "../dist": "dist",
      "../backend-dist/hermes-backend": "hermes-backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}