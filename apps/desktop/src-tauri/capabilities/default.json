{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the app windows.",
  "windows": ["main", "session-*", "instance-*", "screenshot-overlay"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "shell:default",
    "fs:default",
    "dialog:default",
    "store:default",
    "loopback-commands"
  ]
}